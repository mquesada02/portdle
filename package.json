{
	"name": "portdle",
	"description": "Wordle-like daily game for network ports.",
	"repository": {
		"type": "git",
		"url": "https://github.com/mquesada02/portdle.git"
	},
	"license": "MIT",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@10.32.1",
	"scripts": {
		"dev": "tsx scripts/dev.ts",
		"build": "tsc -b && vite build && tsx scripts/copy-index-html-to-404.ts",
		"preview": "vite preview",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -b --noEmit",
		"gen:schedule": "tsx scripts/gen-schedule.ts",
		"gen:catalog-migration": "tsx scripts/gen-catalog-migration.ts",
		"schedule:generate": "tsx scripts/schedule-generator.ts",
		"dev:schedule": "tsx scripts/fill-local-schedule.ts",
		"smoke:backend": "tsx scripts/smoke-backend.ts",
		"test:sql": "scripts/run-sql-tests.sh"
	},
	"dependencies": {
		"@leeoniya/ufuzzy": "^1.0.19",
		"@supabase/supabase-js": "^2.117.2",
		"@tanstack/react-router": "^1.170.33",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.7",
		"@types/node": "^26.5.0",
		"@types/pg": "^8.23.1",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@vitejs/plugin-react": "^6.1.1",
		"jsdom": "^30.0.1",
		"pg": "^8.23.1",
		"supabase": "2.119.0",
		"tailwindcss": "^4.3.3",
		"tsx": "^4.23.13",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vitest": "^5.0.0"
	}
}
